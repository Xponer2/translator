<?xml version="1.0" encoding="UTF-8"?>
<!-- The converter's libraries (Mixin, Sinytra Adapter) log through log4j: errors only; the converter reports problems itself. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_ERR">
            <PatternLayout pattern="[%level] %logger{1}: %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="error">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
